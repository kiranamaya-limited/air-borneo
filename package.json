{
  "name": "air-borneo",
  "private": true,
  "version": "0.1.0",
  "description": "AirBorneo Fresh Cargo Run: fly an ATR from Kuching to Singapore with your phone as the yoke.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
